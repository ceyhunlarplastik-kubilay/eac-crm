generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum CustomerReachStatus {
  REACHED
  NOT_REACHED
  UNKNOWN
}

enum InterestStatus {
  INTERESTED
  NOT_INTERESTED
  UNKNOWN
}

enum SampleStatus {
  WILL_SEND
  WILL_NOT_SEND
  SENT
  UNKNOWN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
}

enum CallRecordingStatus {
  UPLOADING
  QUEUED
  TRANSCRIBING
  ANALYZING
  COMPLETED
  FAILED
}

model Customer {
  id                         String              @id @default(cuid())
  dedupeKey                  String              @unique
  sequenceNumber             Int?
  companyName                String
  website                    String?
  email                      String?
  phone                      String?
  city                       String?
  categoryId                 String?
  category                   Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  contactName                String?
  mobilePhone                String?
  reached                    CustomerReachStatus @default(UNKNOWN)
  callCount                  Int                 @default(0)
  lastContactedAt            DateTime?
  contactDetail              String?
  interestStatus             InterestStatus      @default(UNKNOWN)
  catalogSent                Boolean?
  hasSuitableProductGroup    Boolean?
  currentAccountInfoReceived Boolean?
  sampleStatus               SampleStatus        @default(UNKNOWN)
  shipmentDate               DateTime?
  sourceRowNumber            Int?
  sourceImportBatchId        String?
  sourceImportBatch          ImportBatch?        @relation(fields: [sourceImportBatchId], references: [id], onDelete: SetNull)
  createdByEmail             String?
  createdByName              String?
  updatedByEmail             String?
  updatedByName              String?
  deletedAt                  DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  activities                 ActivityLog[]
  contacts                   CustomerContact[]
  callRecordings             CallRecording[]

  @@index([companyName])
  @@index([city])
  @@index([categoryId])
  @@index([updatedAt])
  @@index([deletedAt])
}

model CallRecording {
  id                   String              @id @default(uuid())
  customerId           String
  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  fileName             String
  fileSize             Int
  contentType          String
  mediaFormat          String
  s3Bucket             String
  s3Key                String              @unique
  representativeName   String
  recordedAt           DateTime?
  languageCode         String              @default("tr-TR")
  speakerMode          String              @default("diarization")
  status               CallRecordingStatus @default(UPLOADING)
  attempt              Int                 @default(1)
  workflowExecutionArn String?
  transcribeJobName    String?
  transcriptS3Key      String?
  transcriptText       String?
  transcriptSegments   Json?
  durationSeconds      Float?
  averageConfidence    Float?
  analysis             Json?
  catalogSources       Json?
  modelId              String?
  promptVersion        String?
  inputTokens          Int?
  outputTokens         Int?
  errorCode            String?
  errorMessage         String?
  uploadedBySub        String
  uploadedByEmail      String?
  uploadedByName       String?
  uploadedAt           DateTime?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([customerId, createdAt])
  @@index([status, updatedAt])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  customers Customer[]
}

model CustomerContact {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactedAt DateTime
  note        String?
  actorSub    String?
  actorEmail  String?
  actorName   String?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([contactedAt])
}

model ImportBatch {
  id            String        @id @default(cuid())
  fileName      String
  totalRows     Int
  createdCount  Int           @default(0)
  updatedCount  Int           @default(0)
  skippedCount  Int           @default(0)
  actorSub      String?
  actorEmail    String?
  actorName     String?
  createdAt     DateTime      @default(now())
  customers     Customer[]
  activities    ActivityLog[]
}

model ActivityLog {
  id            String      @id @default(cuid())
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  action        AuditAction
  summary       String
  changes       Json?
  actorSub      String?
  actorEmail    String?
  actorName     String?
  createdAt     DateTime    @default(now())

  @@index([customerId])
  @@index([importBatchId])
  @@index([actorEmail])
  @@index([createdAt])
}
