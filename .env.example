DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"
DIRECT_URL=""
AUTH_SECRET="replace-with-a-long-random-secret"
APP_TIME_ZONE="Europe/Istanbul"
CUSTOMER_WRITES_PAUSED="false"

# AWS post-call analytics. Resources use the current SST / AWS profile region.
POST_CALL_ANALYTICS_ENABLED="true"
# Google Cloud / Vertex AI. Local CLI and sst dev use Application Default Credentials.
GOOGLE_CLOUD_PROJECT="e-aparat-crm"
GOOGLE_CLOUD_LOCATION="europe-west4"
EMBEDDING_MODEL_ID="gemini-embedding-001"
GEMINI_MODEL_ID="gemini-3.1-flash-lite"
GEMINI_LOCATION="eu"
# Optional local ADC path. SST automatically supplies the default path to dev workers.
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/application_default_credentials.json"
# Deploy uses AWS Workload Identity Federation; defaults to .local/google/wif-{stage}.json.
# GOOGLE_WIF_CONFIG_PATH=".local/google/wif-kubi.json"
# Optional extra frontend origins, comma separated. SST automatically adds the web URL.
CALL_RECORDINGS_ALLOWED_ORIGINS=""
# For standalone Next.js only; sst dev / deploy supplies these automatically.
CALL_RECORDING_API_URL=""
CALL_ANALYTICS_REGION="eu-west-1"
