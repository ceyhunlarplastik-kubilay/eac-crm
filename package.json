{
  "name": "eac-crm",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "sst dev",
    "deploy": "sst deploy",
    "remove": "sst remove",
    "frontend:dev": "npm run dev -w @eac-crm/frontend",
    "frontend:build": "npm run build -w @eac-crm/frontend",
    "db:generate": "npm run db:generate -w @eac-crm/frontend",
    "db:status": "npm run db:status -w @eac-crm/frontend",
    "db:migrate": "npm run db:migrate -w @eac-crm/frontend",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @eac-crm/frontend --",
    "db:categories": "npm run db:categories -w @eac-crm/frontend --",
    "test:categories": "npm run test:categories -w @eac-crm/frontend",
    "db:push": "npm run db:push -w @eac-crm/frontend",
    "db:studio": "npm run db:studio -w @eac-crm/frontend",
    "typecheck": "npm run typecheck -w @eac-crm/frontend && npm run typecheck -w @eac-crm/call-analytics",
    "typecheck:infra": "tsc -p tsconfig.infra.json",
    "test:call-analytics": "npm run test -w @eac-crm/call-analytics",
    "catalog:sync": "node --import tsx packages/call-analytics/scripts/catalog.ts",
    "google:verify": "node --import tsx packages/call-analytics/scripts/google-verify.ts",
    "google:federation": "node --import tsx packages/call-analytics/scripts/google-federation.ts"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22",
    "typescript": "^5"
  },
  "dependencies": {
    "sst": "4.17.1"
  }
}
